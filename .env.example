# ベニー様版 GoQ 自動化の設定。これをコピーして .env を作る（.env は Git に入らない）。
# 認証情報はすべてこのファイル（.env）に置く。Windows 資格情報マネージャーは使わない。

# ---- GoQ ログイン（フロー1）----
# ログインURLは既定 https://order.goqsystem.com/goq21/form/goqsystem_new/systemlogin.php（違うときだけ設定）
# GOQ_LOGIN_URL=
GOQ_USER_ID=
GOQ_PASSWORD=
GOQ_SEQ_ID=
GOQ_SEQ_PW=

# ---- ヤマトビジネスメンバーズ / B2クラウド（フロー4）----
# お客様コード（半角数字9〜12桁）（#code1）、ハイフン以降の枝番（3桁、#code2、持っている場合のみ）、パスワード（#password）
YAMATO_BENY_CODE=
YAMATO_BENY_EDABAN=
YAMATO_BENY_PASSWORD=
# ログイン後のホームに表示されているはずの会社名（確認に使う）
YAMATO_EXPECTED_COMPANY=合同会社Ｂｅｎｙ
# ログイン画面（HMPLGI0010）の入力欄。既定値は 2026-09-30 の走査結果。画面が変わったときだけ上書きする
# YAMATO_SELECTOR_CODE=#code1
# YAMATO_SELECTOR_EDABAN=#code2
# YAMATO_SELECTOR_PASSWORD=#password
# YAMATO_SELECTOR_SUBMIT=a.login

# ---- Chrome（リモートデバッグ）----
GOQ_CDP_PORT=9223

# ---- プリンタ（Chrome 印刷プレビューの送信先名に「含まれる」文字列）----
# このPC: FUJIFILM Apeos C5240普通紙 / FUJIFILM Apeos C5240ヤマト / FUJIFILM Apeos C5240佐川 / FUJIFILM Apeos C5240ネコポス（手差し）
PRINTER_PICKING=普通紙
PRINTER_YAMATO=ヤマト
PRINTER_NEKOPOSU=ネコポス
PRINTER_COMPACT=コンパクト
PRINTER_SAGAWA=佐川

# ---- GoQ 送り状データ出力（B2クラウド形式）の <option value>（2026-09-30 実画面で b2_cloud を確認済み）----
# GOQ_B2_CSV_FORMAT_VALUE=b2_cloud
# ---- ピッキング用カスタムCSVの番号（ベニー様は 1「カスタムCSV全項目(サンプル)」）----
# GOQ_PICKING_CSV_CUSTOM_ID=1

# ---- ピッキングリスト（ベニー様_ピッキング参照）----
# PICKING_MASTER_SHEET_ID=1XjamST5FsXEP1-SnPZUotp3naU-KFSgOU57YKmbEwo8
# PICKING_MASTER_RANGE=GoQ全データ   （タブ名。代わりに URL の gid を PICKING_MASTER_GID で指定してもよい）
# PICKING_MASTER_GID=1344234198
# PICKING_CREDENTIALS_FILE=credentials.json

# ---- 販売データ日次集計（run_all.py。元版のまま。使うときにベニー様用IDを入れる）----
PRICETAR_EMAIL=
PRICETAR_PASSWORD=
GSHEET_ID=
GSHEET_NAME=
SOURCE_BOOK_ID=
GOQ_BOOK_ID=
FUKA_BOOK_ID=
CREDENTIALS_FILE=credentials.json
DOWNLOAD_DIR=販売データダウンロード

# --- チェック項目/フラグ・コンパクト（2026-09-30 追加） ---
# GoQ にコンパクト用のステータスを作ったら、その番号（index.php?stat=◯◯）を入れると --status compact が使える
# GOQ_COMPACT_STAT=
# GOQ_COMPACT_LABEL=
# チェック項目/フラグの一括変更欄が自動で見つからない場合に、実画面で確認したCSSセレクタで固定する
# GOQ_CHECK_FLAG_SELECT=
# GOQ_CHECK_FLAG_BUTTON=
